from ROOT import *
from math import *
import numpy as np
from iminuit import Minuit

#parte I
file1 = open("Millikan.dat")

#istogramma
h1 = TH1D("h1","Istogramma di Millikan",180,0,0)
for line in file1:
    val = line.split()
    h1.Fill(double(val[0]))
    

#fit di multigaussiane
mg = TF1("mg","[0]*TMath::Gaus(x,[1],[2],1)+[3]*TMath::Gaus(x,2*[1],[2],1)+[4]*TMath::Gaus(x,3*[1],[2],1)+[5]*TMath::Gaus(x,4*[1],[2],1)",0,14)
mg.SetParameter(0,4) #ampiezza
mg.SetParameter(1,1.6) #valore medio
mg.SetParameter(2,0.5) #sigma
mg.SetParameter(3,4) 
mg.SetParameter(4,5) 
mg.SetParameter(5,2)

h1.Draw()
h1.Fit("mg")
E = mg.GetParameter(1)
errE = mg.GetParError(1)
print "Carica Elettrone = %f +- %f" %(E,errE)
gApplication.Run(True)

